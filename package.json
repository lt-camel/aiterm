{
  "name": "aiterm",
  "version": "0.1.0",
  "description": "AI-Native 本地 SSH Remote Terminal Runtime，为人类和 AI Agent 提供统一的远程连接、Shell 执行、交互会话与文件传输能力。",
  "type": "module",
  "bin": {
    "aiterm": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ssh",
    "terminal",
    "remote",
    "ai-agent",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.7.0",
    "vitest": "^2.1.0"
  }
}